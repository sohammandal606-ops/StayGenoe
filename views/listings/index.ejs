<% layout('layouts/boilerplate') %>

<!-- ==========================================
     HERO SECTION (BOOKIE LUXURY STYLE)
     ========================================== -->
<div class="hero-wrapper">
    <div class="hero-banner">
        <div class="hero-content">
            <h1 class="hero-title">
                <span class="highlight">Discover</span> Your Perfect<br>Escape.
            </h1>
            <p class="hero-subtitle">
                Book handpicked luxury hotels with seamless payments and exclusive member rates worldwide.
            </p>
            <a href="#featured" class="hero-cta-btn">
                <i class="fa-solid fa-compass"></i> Search Hotels
            </a>
        </div>

        <!-- Floating Glassmorphic Search Bar -->
        <div class="hero-search-container">
            <form action="/listings" method="GET" class="search-grid-form" role="search">
                <!-- Location Field -->
                <div class="search-field-item">
                    <label class="search-field-label" for="searchLocation">
                        <i class="fa-solid fa-location-dot"></i> Location
                    </label>
                    <input type="text" id="searchLocation" name="q" class="search-field-input"
                        placeholder="Where are you going" value="<%= typeof query !== 'undefined' ? query : '' %>"
                        autocomplete="off">
                </div>

                <!-- Check-In Field -->
                <div class="search-field-item">
                    <label class="search-field-label" for="searchCheckIn">
                        <i class="fa-regular fa-calendar"></i> Check-In
                    </label>
                    <input type="date" id="searchCheckIn" class="search-field-input" placeholder="Add Date">
                </div>

                <!-- Check-Out Field -->
                <div class="search-field-item">
                    <label class="search-field-label" for="searchCheckOut">
                        <i class="fa-regular fa-calendar-check"></i> Check-Out
                    </label>
                    <input type="date" id="searchCheckOut" class="search-field-input" placeholder="Add Date">
                </div>

                <!-- Travelers Field -->
                <div class="search-field-item">
                    <label class="search-field-label" for="searchTravelers">
                        <i class="fa-solid fa-user-group"></i> Travelers
                    </label>
                    <input type="text" id="searchTravelers" class="search-field-input" placeholder="Add Guests (e.g. 2)">
                </div>

                <!-- Submit Button -->
                <button type="submit" class="search-submit-btn" title="Search Hotels" aria-label="Search Hotels">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ==========================================
     FEATURED HOTELS SECTION
     ========================================== -->
<div class="container" id="featured">
    <div class="section-header-row">
        <h2 class="section-title">Featured Hotels</h2>
        <div class="category-pills-group" id="hotelCategoryFilters">
            <button type="button" class="category-pill active" data-filter="all">All Stays</button>
            <button type="button" class="category-pill" data-filter="luxury">Luxury</button>
            <button type="button" class="category-pill" data-filter="budget">Budget</button>
            <button type="button" class="category-pill" data-filter="beach">Beach</button>
            <button type="button" class="category-pill" data-filter="pet-friendly">Pet Friendly</button>
        </div>
    </div>

    <% if (typeof query !== 'undefined' && query) { %>
        <div class="d-flex align-items-center justify-content-between mb-4 p-3 rounded-4 bg-white shadow-sm border">
            <div>
                <span class="text-muted">Showing search results for:</span>
                <strong class="text-dark ms-1">"<%= query %>"</strong>
                <span class="badge bg-secondary ms-2"><%= allListings.length %> found</span>
            </div>
            <a href="/listings" class="btn btn-sm btn-outline-dark rounded-pill px-3">Clear Filter</a>
        </div>
    <% } %>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4" id="listingsGrid">
        <% if(allListings.length === 0) { %>
            <div class="col-12 text-center py-5">
                <div class="p-5 rounded-4 bg-white shadow-sm border mx-auto" style="max-width: 500px;">
                    <i class="fa-solid fa-hotel text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4>No listings found</h4>
                    <p class="text-muted">Try searching with a different keyword or location.</p>
                    <a href="/listings" class="btn btn-primary mt-2">View All Listings</a>
                </div>
            </div>
        <% } %>

        <% for(let listing of allListings) { %>
            <div class="col listing-item-card" 
                 data-price="<%= listing.price || 0 %>" 
                 data-title="<%= (listing.title || '').toLowerCase() %>" 
                 data-location="<%= (listing.location || '').toLowerCase() %>" 
                 data-country="<%= (listing.country || '').toLowerCase() %>"
                 data-desc="<%= (listing.description || '').toLowerCase() %>">
                <a href="/listings/<%= listing._id %>" class="text-decoration-none d-block h-100">
                    <div class="hotel-card">
                        <div class="hotel-image-box">
                            <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=800' %>"
                                class="hotel-image" 
                                alt="<%= listing.title %>"
                                loading="lazy">
                        </div>
                        <div class="hotel-card-body">
                            <div class="hotel-header-row">
                                <h5 class="hotel-title"><%= listing.title %></h5>
                                <div class="hotel-rating">
                                    <i class="fa-solid fa-star"></i>
                                    <span><%= (4.6 + ((listing.price % 5) * 0.08)).toFixed(1) %></span>
                                </div>
                            </div>
                            <div class="hotel-location">
                                <i class="fa-solid fa-location-dot"></i>
                                <span><%= listing.location %>, <%= listing.country %></span>
                            </div>
                            <p class="hotel-description">
                                <%= listing.description || 'Book handpicked luxury hotels with seamless payments and exclusive member rates.' %>
                            </p>
                            <div class="hotel-footer-row">
                                <span class="hotel-price-tag">
                                    &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : '2,500' %>
                                </span>
                                <span class="hotel-per-night">/Night</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
</div>

<!-- ==========================================
     TRENDING DESTINATIONS SECTION
     ========================================== -->
<div class="container destinations-wrapper" id="destinations">
    <div class="section-header-row">
        <h2 class="section-title">Trending Destinations.</h2>
        <div class="category-pills-group" id="destinationRegionFilters">
            <button type="button" class="category-pill active" data-dest-filter="all">All</button>
            <button type="button" class="category-pill" data-dest-filter="asia">Asia</button>
            <button type="button" class="category-pill" data-dest-filter="europe">Europe</button>
            <button type="button" class="category-pill" data-dest-filter="americas">Americas</button>
            <button type="button" class="category-pill" data-dest-filter="middle-east">Middle East</button>
        </div>
    </div>

    <div class="row row-cols-lg-5 row-cols-md-3 row-cols-2 g-3" id="destinationsGrid">
        <!-- Destination 1: Santorini -->
        <div class="col dest-item" data-region="europe">
            <a href="/listings?q=Greece" class="text-decoration-none">
                <div class="destination-card">
                    <img src="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?q=80&w=600&auto=format&fit=crop"
                        alt="Santorini, Greece" loading="lazy">
                    <div class="destination-card-overlay">
                        <h6 class="destination-card-title">Santorini</h6>
                        <span class="destination-card-subtitle">Greece &bull; 120+ Stays</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Destination 2: Bali -->
        <div class="col dest-item" data-region="asia">
            <a href="/listings?q=Bali" class="text-decoration-none">
                <div class="destination-card">
                    <img src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?q=80&w=600&auto=format&fit=crop"
                        alt="Bali, Indonesia" loading="lazy">
                    <div class="destination-card-overlay">
                        <h6 class="destination-card-title">Bali</h6>
                        <span class="destination-card-subtitle">Indonesia &bull; 240+ Stays</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Destination 3: Kyoto -->
        <div class="col dest-item" data-region="asia">
            <a href="/listings?q=Japan" class="text-decoration-none">
                <div class="destination-card">
                    <img src="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?q=80&w=600&auto=format&fit=crop"
                        alt="Kyoto, Japan" loading="lazy">
                    <div class="destination-card-overlay">
                        <h6 class="destination-card-title">Kyoto</h6>
                        <span class="destination-card-subtitle">Japan &bull; 85+ Stays</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Destination 4: Swiss Alps -->
        <div class="col dest-item" data-region="europe">
            <a href="/listings?q=Switzerland" class="text-decoration-none">
                <div class="destination-card">
                    <img src="https://images.unsplash.com/photo-1530122037265-a5f1f91d3b99?q=80&w=600&auto=format&fit=crop"
                        alt="Swiss Alps, Switzerland" loading="lazy">
                    <div class="destination-card-overlay">
                        <h6 class="destination-card-title">Swiss Alps</h6>
                        <span class="destination-card-subtitle">Switzerland &bull; 94+ Stays</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Destination 5: Dubai -->
        <div class="col dest-item" data-region="middle-east">
            <a href="/listings?q=Dubai" class="text-decoration-none">
                <div class="destination-card">
                    <img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?q=80&w=600&auto=format&fit=crop"
                        alt="Dubai, UAE" loading="lazy">
                    <div class="destination-card-overlay">
                        <h6 class="destination-card-title">Dubai</h6>
                        <span class="destination-card-subtitle">UAE &bull; 160+ Stays</span>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Category Filtering Client Script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Hotel Category Pills Filter
        const hotelPills = document.querySelectorAll('#hotelCategoryFilters .category-pill');
        const listingCards = document.querySelectorAll('.listing-item-card');

        hotelPills.forEach(pill => {
            pill.addEventListener('click', () => {
                hotelPills.forEach(p => p.classList.remove('active'));
                pill.classList.add('active');

                const filter = pill.getAttribute('data-filter');

                listingCards.forEach(card => {
                    const price = parseFloat(card.getAttribute('data-price')) || 0;
                    const text = (card.getAttribute('data-title') + ' ' + 
                                  card.getAttribute('data-location') + ' ' + 
                                  card.getAttribute('data-desc') + ' ' + 
                                  card.getAttribute('data-country')).toLowerCase();

                    let show = true;
                    if (filter === 'luxury') {
                        show = price >= 3000 || text.includes('luxury') || text.includes('villa') || text.includes('resort');
                    } else if (filter === 'budget') {
                        show = price < 3000 || text.includes('cozy') || text.includes('budget') || text.includes('cottage');
                    } else if (filter === 'beach') {
                        show = text.includes('beach') || text.includes('sea') || text.includes('ocean') || text.includes('island');
                    } else if (filter === 'pet-friendly') {
                        show = text.includes('pet') || text.includes('cabin') || text.includes('farm') || price % 2 === 0;
                    }

                    card.style.display = show ? '' : 'none';
                });
            });
        });

        // Destination Region Filter
        const destPills = document.querySelectorAll('#destinationRegionFilters .category-pill');
        const destItems = document.querySelectorAll('.dest-item');

        destPills.forEach(pill => {
            pill.addEventListener('click', () => {
                destPills.forEach(p => p.classList.remove('active'));
                pill.classList.add('active');

                const filter = pill.getAttribute('data-dest-filter');
                destItems.forEach(item => {
                    const region = item.getAttribute('data-region');
                    if (filter === 'all' || region === filter) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });
    });
</script>