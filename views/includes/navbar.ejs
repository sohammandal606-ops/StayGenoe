<div class="custom-navbar-wrapper">
    <nav class="navbar navbar-expand-lg custom-navbar">
        <div class="container-fluid p-0">
            <!-- Brand Logo -->
            <a class="navbar-brand brand-logo" href="/listings">
                <i class="fa-solid fa-compass"></i>
                <span>StayGenoe</span>
            </a>

            <!-- Mobile Right: Theme Toggle + Hamburger -->
            <div class="d-flex align-items-center gap-2 d-lg-none">
                <button id="themeToggleMobile" class="theme-toggle-btn" title="Toggle Theme" aria-label="Toggle Theme">
                    <i class="fa-solid fa-moon"></i>
                </button>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                    data-bs-target="#staygenoeNavbar" aria-controls="staygenoeNavbar" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars-staggered" style="color: var(--primary-color);"></i>
                </button>
            </div>

            <!-- Navbar Links (collapsible) -->
            <div class="collapse navbar-collapse" id="staygenoeNavbar">
                <!-- Center Nav Links -->
                <div class="navbar-nav mx-auto nav-links-center my-3 my-lg-0" style="display: flex !important;">
                    <a class="nav-link nav-link-custom active" href="/listings">Home</a>
                    <a class="nav-link nav-link-custom" href="/listings#featured">Featured</a>
                    <a class="nav-link nav-link-custom" href="/listings#destinations">Destinations</a>
                    <a class="nav-link nav-link-custom" href="/listings/new">Add Home</a>
                </div>

                <!-- Right Action Buttons (desktop visible) -->
                <div class="nav-actions d-none d-lg-flex flex-wrap">
                    <button id="themeToggle" class="theme-toggle-btn" title="Toggle Theme" aria-label="Toggle Theme">
                        <i class="fa-solid fa-moon"></i>
                    </button>

                    <button class="nav-notify-btn" title="Notifications" aria-label="Notifications">
                        <i class="fa-solid fa-bell"></i>
                    </button>

                    <% if(!currentUser) { %>
                        <a class="nav-pill-btn-outline d-none d-sm-inline-flex" href="/signup">Sign up</a>
                        <a class="nav-pill-btn" href="/login">
                            <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Login
                        </a>
                    <% } else { %>
                        <a class="nav-pill-btn-outline" href="/profile">
                            <% if (currentUser.image && currentUser.image.url) { %>
                                <img src="<%= currentUser.image.url %>" alt="Profile" class="rounded-circle me-1"
                                    style="width: 20px; height: 20px; object-fit: cover;">
                            <% } else { %>
                                <i class="fa-solid fa-user me-1"></i>
                            <% } %>
                            <%= currentUser.username %>
                        </a>
                        <a class="nav-pill-btn" href="/logout">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
                        </a>
                    <% } %>
                </div>

                <!-- Mobile Auth Buttons (only inside collapse) -->
                <div class="d-flex flex-wrap gap-2 pb-3 d-lg-none">
                    <% if(!currentUser) { %>
                        <a class="nav-pill-btn-outline" href="/signup" style="display:inline-flex;">Sign up</a>
                        <a class="nav-pill-btn" href="/login" style="display:inline-flex;">
                            <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Login
                        </a>
                    <% } else { %>
                        <a class="nav-pill-btn-outline" href="/profile" style="display:inline-flex;">
                            <i class="fa-solid fa-user me-1"></i> <%= currentUser.username %>
                        </a>
                        <a class="nav-pill-btn" href="/logout" style="display:inline-flex;">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
</div>

<script>
    // Sync mobile and desktop theme toggles
    const themeToggleMobile = document.getElementById('themeToggleMobile');
    if (themeToggleMobile) {
        themeToggleMobile.addEventListener('click', () => {
            document.body.classList.toggle('dark-mode');
            const isDark = document.body.classList.contains('dark-mode');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            const icon = themeToggleMobile.querySelector('i');
            if (icon) icon.className = isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            const desktopToggle = document.getElementById('themeToggle');
            if (desktopToggle) {
                const desktopIcon = desktopToggle.querySelector('i');
                if (desktopIcon) desktopIcon.className = isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }
        });
    }
</script>
