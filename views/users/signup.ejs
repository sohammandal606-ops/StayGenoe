<% layout('layouts/boilerplate') %>

<div class="auth-page-wrapper">
    <!-- Brand Logo in Top Left -->
    <div class="auth-brand-badge">
        <i class="fa-solid fa-compass"></i>
        <span>StayGenoe</span>
    </div>

    <!-- Floating Auth Card -->
    <div class="auth-card-container">
        <div class="auth-floating-card">
            <h2 class="auth-card-title">Create an Account</h2>
            <p class="auth-card-subtitle">Join StayGenoe to book luxury stays worldwide</p>

            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <!-- Username -->
                <div class="mb-3">
                    <label for="username" class="auth-field-label">Username</label>
                    <input type="text" id="username" name="username" class="auth-input-control"
                        placeholder="Choose a username" required autocomplete="username">
                    <div class="invalid-feedback">Please choose a username.</div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="auth-field-label">Email Address</label>
                    <input type="email" id="email" name="email" class="auth-input-control"
                        placeholder="name@domain.com" required autocomplete="email">
                    <div class="invalid-feedback">Please provide a valid email.</div>
                </div>

                <!-- Password -->
                <div class="mb-4">
                    <label for="password" class="auth-field-label">Password</label>
                    <input type="password" id="password" name="password" class="auth-input-control"
                        placeholder="••••••••••••" required autocomplete="new-password">
                    <div class="invalid-feedback">Please create a secure password.</div>
                </div>

                <!-- Sign Up Button -->
                <button type="submit" class="btn-auth-dark mb-3">
                    Create Account
                </button>

                <!-- Google OAuth -->
                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1 border-secondary opacity-25">
                    <span class="mx-2 text-muted small">or continue with</span>
                    <hr class="flex-grow-1 border-secondary opacity-25">
                </div>

                <a href="/auth/google" class="btn-google-auth-pill">
                    <img src="https://developers.google.com/identity/images/g-logo.png" width="18" height="18" alt="Google logo">
                    <span>Google Account</span>
                </a>
            </form>

            <p class="auth-bottom-text">
                Already have an account? <a href="/login" class="auth-bottom-link">Sign in</a>
            </p>
        </div>
    </div>
</div>